    clickDetector.MouseClick:Connect(function()
        if not scriptAtivo then return end
        placaSelecionadaParaEdicao = numeroPlaca
        textoDigitado = ""
        if tecladoGUI then
            tecladoGUI:Destroy()
            tecladoGUI = nil
        end
        criarTeclado()
        tecladoAtivo = true
    end)
    
    -- Armazenar referências (usando a placa principal como referência)
