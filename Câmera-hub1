--// FUNÇÃO CRIAR CÂMERA (ALTERADA - MENOR, MODERNA E COM VISIBILIDADE CORRIGIDA)
local function criarCameraRealista(position)
	local model = Instance.new("Model")
	model.Name = "Camera3D"
	model.Parent = workspace

	-- CORPO PRINCIPAL (MENOR)
	local corpo = Instance.new("Part")
	corpo.Size = Vector3.new(1.2, 1.0, 1.1)
	corpo.Material = Enum.Material.SmoothPlastic
	corpo.Color = Color3.fromRGB(20, 20, 25)
	corpo.Anchored = true
	corpo.CanCollide = false
	corpo.CFrame = position
	corpo.Parent = model

	-- TOPO ARREDONDADO
	local topo = Instance.new("Part")
	topo.Shape = Enum.PartType.Cylinder
	topo.Size = Vector3.new(0.9, 0.4, 0.9)
	topo.Material = Enum.Material.SmoothPlastic
	topo.Color = Color3.fromRGB(35, 35, 40)
	topo.Anchored = true
	topo.CanCollide = false
	topo.CFrame = corpo.CFrame * CFrame.new(0, 0.7, 0.15)
	topo.Parent = model

	-- LENTE PRINCIPAL
	local lente = Instance.new("Part")
	lente.Shape = Enum.PartType.Cylinder
	lente.Size = Vector3.new(0.5, 1.0, 1.0)
	lente.Material = Enum.Material.Glass
	lente.Color = Color3.fromRGB(10, 10, 15)
	lente.Transparency = 0.15
	lente.Reflectance = 0.7
	lente.Anchored = true
	lente.CanCollide = false
	lente.CFrame = corpo.CFrame * CFrame.new(0, -0.05, -0.9) * CFrame.Angles(0, 0, math.rad(90))
	lente.Parent = model

	-- ANEL DA LENTE
	local anel = Instance.new("Part")
	anel.Shape = Enum.PartType.Cylinder
	anel.Size = Vector3.new(0.2, 1.1, 1.1)
	anel.Material = Enum.Material.Metal
	anel.Color = Color3.fromRGB(60, 60, 65)
	anel.Reflectance = 0.5
	anel.Anchored = true
	anel.CanCollide = false
	anel.CFrame = lente.CFrame * CFrame.new(0, 0, 0)
	anel.Parent = model

	-- LENTE INTERNA
	local lenteInterna = Instance.new("Part")
	lenteInterna.Shape = Enum.PartType.Cylinder
	lenteInterna.Size = Vector3.new(0.3, 0.6, 0.6)
	lenteInterna.Material = Enum.Material.Glass
	lenteInterna.Color = Color3.fromRGB(30, 30, 80)
	lenteInterna.Transparency = 0.4
	lenteInterna.Reflectance = 0.8
	lenteInterna.Anchored = true
	lenteInterna.CanCollide = false
	lenteInterna.CFrame = lente.CFrame * CFrame.new(0.15, 0, 0)
	lenteInterna.Parent = model

	-- FLASH
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(0.2, 0.2, 0.2)
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 255, 220)
	flash.Anchored = true
	flash.CanCollide = false
	flash.CFrame = topo.CFrame * CFrame.new(-0.35, 0.1, -0.3)
	flash.Parent = model

	-- LED DE GRAVAÇÃO
	local ledGravacao = Instance.new("Part")
	ledGravacao.Shape = Enum.PartType.Ball
	ledGravacao.Size = Vector3.new(0.15, 0.15, 0.15)
	ledGravacao.Material = Enum.Material.Neon
	ledGravacao.Color = Color3.fromRGB(255, 0, 0)
	ledGravacao.Anchored = true
	ledGravacao.CanCollide = false
	ledGravacao.CFrame = corpo.CFrame * CFrame.new(-0.5, 0.4, -0.45)
	ledGravacao.Parent = model

	local luzGravacao = Instance.new("PointLight")
	luzGravacao.Brightness = 2
	luzGravacao.Range = 4
	luzGravacao.Color = Color3.fromRGB(255, 0, 0)
	luzGravacao.Parent = ledGravacao

	spawn(function()
		while ledGravacao and ledGravacao.Parent do
			ledGravacao.Transparency = 0
			luzGravacao.Enabled = true
			wait(0.8)
			ledGravacao.Transparency = 0.6
			luzGravacao.Enabled = false
			wait(0.8)
		end
	end)

	-- VISOR DIGITAL
	local visor = Instance.new("Part")
	visor.Size = Vector3.new(0.8, 0.6, 0.08)
	visor.Material = Enum.Material.Neon
	visor.Color = Color3.fromRGB(5, 5, 10)
	visor.Anchored = true
	visor.CanCollide = false
	visor.CFrame = corpo.CFrame * CFrame.new(0, 0.15, 0.65)
	visor.Parent = model

	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Face = Enum.NormalId.Front
	surfaceGui.Parent = visor

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	frame.BorderSizePixel = 0
	frame.Parent = surfaceGui

	local textoRec = Instance.new("TextLabel")
	textoRec.Size = UDim2.new(0.6, 0, 0.5, 0)
	textoRec.Position = UDim2.new(0.2, 0, 0.25, 0)
	textoRec.BackgroundTransparency = 1
	textoRec.Text = "● REC"
	textoRec.TextColor3 = Color3.fromRGB(255, 0, 0)
	textoRec.TextScaled = true
	textoRec.Font = Enum.Font.GothamBold
	textoRec.Parent = frame

	-- BASE DE SUPORTE
	local base = Instance.new("Part")
	base.Size = Vector3.new(1.4, 0.2, 1.3)
	base.Material = Enum.Material.Metal
	base.Color = Color3.fromRGB(40, 40, 45)
	base.Reflectance = 0.3
	base.Anchored = true
	base.CanCollide = false
	base.CFrame = corpo.CFrame * CFrame.new(0, -0.7, 0)
	base.Parent = model

	-- ANTENA
	local antena = Instance.new("Part")
	antena.Shape = Enum.PartType.Cylinder
	antena.Size = Vector3.new(0.1, 0.6, 0.1)
	antena.Material = Enum.Material.Metal
	antena.Color = Color3.fromRGB(80, 80, 85)
	antena.Anchored = true
	antena.CanCollide = false
	antena.CFrame = topo.CFrame * CFrame.new(0.4, 0.35, 0.1)
	antena.Parent = model

	local bolinhaAntena = Instance.new("Part")
	bolinhaAntena.Shape = Enum.PartType.Ball
	bolinhaAntena.Size = Vector3.new(0.12, 0.12, 0.12)
	bolinhaAntena.Material = Enum.Material.Neon
	bolinhaAntena.Color = Color3.fromRGB(0, 150, 255)
	bolinhaAntena.Anchored = true
	bolinhaAntena.CanCollide = false
	bolinhaAntena.CFrame = antena.CFrame * CFrame.new(0, 0.35, 0)
	bolinhaAntena.Parent = model

	-- SISTEMA DE VISIBILIDADE (INVISÍVEL APENAS QUANDO OLHANDO PELA LENTE)
	local cameraPart = corpo
	local lastVisible = true

	local function isLookingThroughLens()
		if not player.Character then return false end
		local playerHead = player.Character:FindFirstChild("Head")
		if not playerHead then return false end

		local cameraPos = cameraPart.Position
		local playerHeadPos = playerHead.Position
		local cameraForward = cameraPart.CFrame.LookVector
		local playerToCamera = (cameraPos - playerHeadPos).Unit
		local dotProduct = cameraForward:Dot(playerToCamera)
		local isInFront = dotProduct < -0.7
		local distance = (cameraPos - playerHeadPos).Magnitude
		local isCloseEnough = distance < 10

		return isInFront and isCloseEnough
	end

	local function updateVisibility()
		local shouldBeVisible = not isLookingThroughLens()

		if shouldBeVisible ~= lastVisible then
			lastVisible = shouldBeVisible

			for _, part in ipairs(model:GetChildren()) do
				if part:IsA("BasePart") then
					if shouldBeVisible then
						part.Transparency = 0
						if part == lente then part.Transparency = 0.15
						elseif part == lenteInterna then part.Transparency = 0.4
						elseif part == visor then part.Transparency = 0
						elseif part == ledGravacao then part.Transparency = 0
						else part.Transparency = 0
						end
					else
						part.Transparency = 1
					end
				end
			end

			if shouldBeVisible then
				surfaceGui.Enabled = true
			else
				surfaceGui.Enabled = false
			end
		end
	end

	spawn(function()
		while model and model.Parent do
			wait(0.1)
			updateVisibility()
		end
	end)

	RunService.RenderStepped:Connect(function()
		if model and model.Parent then
			updateVisibility()
		end
	end)

	model.PrimaryPart = corpo
	return corpo
end

