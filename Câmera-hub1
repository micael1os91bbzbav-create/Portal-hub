-- Função para processar números das câmeras
local function processarNumerosCamera(texto)
	local numeros = {}
	for parte in string.gmatch(texto, "[^,]+") do
		parte = parte:match("^%s*(.-)%s*$")
		if string.find(parte, "-") then
			local inicio, fim = string.match(parte, "(%d+)%-(%d+)")
			if inicio and fim then
				inicio, fim = tonumber(inicio), tonumber(fim)
				for i = inicio, fim do 
					if i >= 1 and i <= #cameras then
						table.insert(numeros, i) 
					end
				end
			end
		else
			local num = tonumber(parte)
			if num and num >= 1 and num <= #cameras then 
				table.insert(numeros, num) 
			end
		end
	end
	return numeros
end

