-- NOVA FUNÇÃO: Criar placa com suporte (pauzinho)
local function criarPlaca(posicao, facingDirection)
    if not scriptAtivo then return end
    
    local numeroPlaca = proximoNumeroPlaca
    proximoNumeroPlaca = proximoNumeroPlaca + 1
    
    -- Criar MODEL para agrupar placa e suporte
    local model = Instance.new("Model")
    model.Name = "Placa_" .. numeroPlaca
    model.Parent = workspace
    
    -- Calcular CFrame para a placa ficar virada para o jogador
    local playerPos = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position or posicao
    local direction = (playerPos - posicao).Unit
    local cframe = CFrame.new(posicao, posicao + Vector3.new(direction.X, 0, direction.Z))
    
    -- ====== PLACA PRINCIPAL (maior: 6x3 para caber mais texto) ======
    local placa = Instance.new("Part")
    placa.Name = "PlacaPrincipal"
    placa.Size = Vector3.new(6, 3, 0.2) -- Aumentado de 4x2 para 6x3
    placa.Material = Enum.Material.Wood
    placa.Color = Color3.fromRGB(139, 69, 19) -- Marrom
    placa.Anchored = true
    placa.CanCollide = false
    placa.CFrame = cframe * CFrame.new(0, 1.5, 0) -- Elevado para ficar acima do suporte
    placa.Parent = model
    
    -- ====== SUPORTE (pauzinho embaixo da placa) ======
    local suporte = Instance.new("Part")
    suporte.Name = "Suporte"
    suporte.Size = Vector3.new(0.4, 2.5, 0.4) -- Pauzinho fino
    suporte.Material = Enum.Material.Wood
    suporte.Color = Color3.fromRGB(101, 67, 33) -- Marrom mais escuro
    suporte.Anchored = true
    suporte.CanCollide = false
    -- Posicionar o suporte no centro da placa, descendo para baixo
    suporte.CFrame = cframe * CFrame.new(0, 0.25, 0) -- Parte inferior da placa na altura 0.25
    suporte.Parent = model
    
    -- ====== BASE DO SUPORTE (opcional, para dar estabilidade) ======
    local base = Instance.new("Part")
    base.Name = "Base"
    base.Size = Vector3.new(1, 0.3, 1)
    base.Material = Enum.Material.Wood
    base.Color = Color3.fromRGB(101, 67, 33)
    base.Anchored = true
    base.CanCollide = false
    base.CFrame = cframe * CFrame.new(0, -1.15, 0) -- Base no chão
    base.Parent = model
    
    -- SurfaceGui para o texto (na placa principal)
    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Front
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surfaceGui.PixelsPerStud = 50
    surfaceGui.Parent = placa
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = ""
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.TextSize = 30
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextScaled = true
    textLabel.TextWrapped = true
    textLabel.Parent = surfaceGui
    
    -- Billboard para o número (acima da placa)
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 60, 0, 60)
    billboard.Adornee = placa
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.Parent = model
    
    local numeroLabel = Instance.new("TextLabel")
    numeroLabel.Size = UDim2.new(1, 0, 1, 0)
    numeroLabel.BackgroundTransparency = 1
    numeroLabel.Text = tostring(numeroPlaca)
    numeroLabel.TextColor3 = Color3.new(1, 1, 1)
    numeroLabel.TextSize = 40
    numeroLabel.Font = Enum.Font.GothamBold
    numeroLabel.TextStrokeTransparency = 0
    numeroLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    numeroLabel.Parent = billboard
    
    -- ClickDetector para editar texto (na placa principal)
    local clickDetector = Instance.new("ClickDetector")
