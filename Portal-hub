-- Função para mostrar mensagem de boas-vindas temporária
local function mostrarMensagemBoasVindas()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "BoasVindas"
    screenGui.Parent = player:WaitForChild("PlayerGui")
    screenGui.ResetOnSpawn = false

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 400, 0, 150)
    frame.Position = UDim2.new(0.5, -200, 0.5, -75)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local texto = Instance.new("TextLabel")
    texto.Size = UDim2.new(1, 0, 1, 0)
    texto.BackgroundTransparency = 1
    texto.Text = "SEJA BEM VINDO AO CÂMERA HUB"
    texto.TextColor3 = Color3.new(1, 1, 1)
    texto.TextSize = 24
    texto.Font = Enum.Font.GothamBold
    texto.TextWrapped = true
    texto.Parent = frame

    -- Efeito de fade in
    frame.BackgroundTransparency = 0.8
    texto.TextTransparency = 0.8
    local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeIn = TweenService:Create(frame, tweenInfo, {BackgroundTransparency = 0.2})
    local fadeInText = TweenService:Create(texto, tweenInfo, {TextTransparency = 0})
    fadeIn:Play()
    fadeInText:Play()

    task.wait(5) -- 5 segundos

    -- Fade out
    local fadeOut = TweenService:Create(frame, tweenInfo, {BackgroundTransparency = 1})
    local fadeOutText = TweenService:Create(texto, tweenInfo, {TextTransparency = 1})
    fadeOut:Play()
    fadeOutText:Play()
    fadeOut.Completed:Connect(function()
        screenGui:Destroy()
        iniciarScriptPrincipal()
    end)
end

-- ==================== INÍCIO DO SISTEMA PRINCIPAL (SÓ EXECUTA APÓS KEY) ====================
local function iniciarScriptPrincipal()
    -- ==================== SISTEMA DE VERSÃO ====================
    local VERSION = "2.1.0"
    local SCRIPT_URL = "https://raw.githubusercontent.com/seu_usuario/seu_repo/main/camera_hub.lua" -- COLOQUE SUA URL AQUI!
    local GITHUB_RAW_URL = "https://raw.githubusercontent.com/seu_usuario/seu_repo/main/version.txt" -- URL para arquivo de versão

    local function checkForUpdates()
        local success, result = pcall(function()
            return game:HttpGet(GITHUB_RAW_URL)
        end)
        
        if success and result then
            local latestVersion = result:match("VERSION=(%d+%.%d+%.%d+)")
            if latestVersion and latestVersion ~= VERSION then
                return true, latestVersion
            end
        end
        return false, VERSION
    end

    local function updateScript()
        local success, newScript = pcall(function()
            return game:HttpGet(SCRIPT_URL)
        end)
        
        if success and newScript then
            return true, newScript
        end
        return false, nil
    end

    -- ==================== INTERFACE DE ATUALIZAÇÃO ====================
    local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

    -- Criar aba de versão
    local Window = Rayfield:CreateWindow({
        Name = "Sistema Completo v" .. VERSION,
        LoadingTitle = "Camera Hub",
        LoadingSubtitle = "Versão " .. VERSION,
        Theme = "Dark"
    })

    local SectionVersao = Window:CreateTab("🔄 Atualizações", 4483362458)

    -- Label de versão atual
    local versionLabel = SectionVersao:CreateLabel("📌 Versão Atual: " .. VERSION)

