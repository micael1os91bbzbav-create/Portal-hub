                qualidadeOriginal = settings().Rendering.QualityLevel
                settings().Rendering.QualityLevel = 1 -- Mínima qualidade
                -- Desabilitar efeitos visuais
                local lighting = game:GetService("Lighting")
                lighting.GlobalShadows = false
                lighting.FogEnd = 1e10
                Rayfield:Notify({Title = "Anti-Lag Ativado", Content = "Qualidade reduzida para máximo desempenho", Duration = 2})
            else
                settings().Rendering.QualityLevel = qualidadeOriginal
                local lighting = game:GetService("Lighting")
                lighting.GlobalShadows = true
                lighting.FogEnd = 100000
                Rayfield:Notify({Title = "Anti-Lag Desativado", Content = "Qualidade restaurada", Duration = 2})
            end
        end
    })

    -- Input para nome personalizado do script
    local nomeInput = SectionExtras:CreateInput({
        Name = "✏️ Digite um nome para o script",
        PlaceholderText = "Ex: Meu Hub",
        RemoveTextAfterFocusLost = false,
        Callback = function(texto) end
    })

    -- Botão para aplicar o nome
    SectionExtras:CreateButton({
        Name = "✅ Aplicar Nome",
        Callback = function()
            local novoNome = nomeInput.CurrentValue
            if novoNome and novoNome ~= "" then
                -- Tenta alterar o título da janela do Rayfield
                -- Procura o ScreenGui principal do Rayfield
                for _, gui in ipairs(player.PlayerGui:GetChildren()) do
                    if gui.Name == "Rayfield" then
                        -- Procura o frame que contém o título (geralmente um TextLabel no topo)
                        local function findTitleFrame(f)
                            for _, child in ipairs(f:GetChildren()) do
                                if child:IsA("TextLabel") and child.Text:find("Sistema Completo") then
                                    child.Text = novoNome
                                    return true
                                elseif child:IsA("Frame") then
                                    if findTitleFrame(child) then return true end
                                end
                            end
                            return false
                        end
                        if findTitleFrame(gui) then
                            Rayfield:Notify({Title = "Nome alterado", Content = "Título atualizado para: " .. novoNome, Duration = 2})
                        else
                            Rayfield:Notify({Title = "Erro", Content = "Não foi possível encontrar o título", Duration = 2})
                        end
                        break
                    end
                end
            else
                Rayfield:Notify({Title = "Erro", Content = "Digite um nome válido", Duration = 2})
            end
        end
    })

    print("=========================================")
    print("✅ SISTEMA COMPLETO CARREGADO!")
    print("📷 Câmeras | 🏃 Movimento | 🌀 Portais")
    print("🔧 Versão: " .. VERSION)
    print("🔄 Sistema de atualização ativo!")
    print("=========================================")
end

